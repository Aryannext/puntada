{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "docs",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs"
      ],
      "port": 8765
    },
    {
      "name": "sistema",
      "runtimeExecutable": "local/runtime/php/php.exe",
      "runtimeArgs": [
        "sistema/artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8012"
      ],
      "port": 8012
    },
    {
      "name": "sistema-con-datos",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "scripts/servidor_de_prueba.py"
      ],
      "port": 8000
    },
    {
      "name": "portal",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--bind",
        "127.0.0.1",
        "--directory",
        "portal"
      ],
      "port": 8766
    }
  ]
}
